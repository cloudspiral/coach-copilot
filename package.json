{
  "name": "coach-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:test": "concurrently -k -n api,web -c cyan,magenta \"tsx src/server/test-index.ts\" \"vite --host 127.0.0.1\"",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:langgraph:setup": "tsx scripts/langgraph-setup.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:langgraph:setup",
    "db:test:setup": "tsx scripts/db-test-setup.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint src tests evals e2e scripts vite.config.ts playwright.config.ts",
    "test": "vitest run --exclude tests/evals.test.ts --exclude tests/database.integration.test.ts",
    "test:evals": "vitest run tests/evals.test.ts",
    "test:live": "tsx evals/run-live.ts",
    "test:quality": "QUALITY_MODEL_MODE=controlled tsx evals/natural-quality.ts",
    "test:quality:live": "tsx evals/natural-quality.ts",
    "test:e2e": "playwright test --grep-invert @live",
    "test:e2e:live": "REQUIRE_LIVE_MODEL=true playwright test --grep @live",
    "test:db": "npm run db:test:setup && vitest run tests/database.integration.test.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "verify:offline": "npm run lint && npm run typecheck && npm run test && npm run test:evals && npm run test:quality && npm run test:db && npm run build && npm run test:e2e",
    "verify": "npm run verify:offline && npm run test:live && npm run test:quality:live && npm run test:e2e:live"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
